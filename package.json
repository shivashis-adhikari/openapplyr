{
  "name": "openapplyr",
  "productName": "OpenApplyr",
  "version": "0.1.0",
  "description": "Open-source, local-first job search agent: finds roles, tailors your resume, applies, follows up, and tracks every application.",
  "license": "AGPL-3.0-only",
  "author": "Shivashis Adhikari",
  "homepage": "https://shivashis-adhikari.github.io/openapplyr/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivashis-adhikari/openapplyr.git"
  },
  "bugs": {
    "url": "https://github.com/shivashis-adhikari/openapplyr/issues"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node scripts/electron-node.mjs node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/electron-node.mjs node_modules/vitest/vitest.mjs",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.web.json",
    "lint": "eslint . && npm run lint:copy && npm run lint:hex",
    "lint:copy": "node --disable-warning=ExperimentalWarning scripts/copy-lint.ts",
    "lint:hex": "node --disable-warning=ExperimentalWarning scripts/hex-lint.ts",
    "e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "dist": "npm run build && electron-builder -c.mac.identity=-",
    "dist:dir": "npm run build && electron-builder --dir -c.mac.identity=-"
  },
  "devDependencies": {
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@playwright/test": "1.63",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "4.13.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.113",
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/azure": "^4.0.99",
    "@ai-sdk/cerebras": "^3.0.67",
    "@ai-sdk/cohere": "^4.0.59",
    "@ai-sdk/deepseek": "^3.0.54",
    "@ai-sdk/fireworks": "^3.0.70",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/google-vertex": "^5.0.109",
    "@ai-sdk/groq": "^4.0.59",
    "@ai-sdk/mistral": "^4.0.62",
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/perplexity": "^5.0.10",
    "@ai-sdk/togetherai": "^3.0.68",
    "@ai-sdk/xai": "^5.0.20",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.15",
    "ai": "^7.0.137",
    "docx": "^9.10.0",
    "dompurify": "^3.4.16",
    "imapflow": "^2.4.0",
    "mailparser": "^3.9.38",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.0.11",
    "ollama-ai-provider-v2": "^4.0.1",
    "playwright-core": "1.64",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.6"
  }
}
